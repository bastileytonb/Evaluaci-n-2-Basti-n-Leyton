<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cl.duoc.viviendas.controller.MainController">
  <top>
    <Label text="Registro de viviendas" BorderPane.alignment="CENTER"/>
  </top>
  <center>
    <TableView fx:id="tblViviendas">
      <columns>
        <TableColumn fx:id="colTipo" text="Tipo" prefWidth="100"/>
        <TableColumn fx:id="colCodigo" text="Código" prefWidth="90"/>
        <TableColumn fx:id="colSuperficie" text="Superficie (m²)" prefWidth="110"/>
        <TableColumn fx:id="colHabitaciones" text="Habitaciones" prefWidth="100"/>
        <TableColumn fx:id="colCosto" text="Costo arriendo" prefWidth="110"/>
      </columns>
      <BorderPane.margin><Insets top="10" right="10" bottom="10" left="20"/></BorderPane.margin>
    </TableView>
  </center>
  <right>
    <VBox spacing="8" prefWidth="250">
      <padding><Insets top="10" right="20" bottom="10" left="10"/></padding>
      <ComboBox fx:id="cmbTipo" promptText="Seleccione..."/>
      <TextField fx:id="txtCodigo" promptText="Código"/>
      <TextField fx:id="txtSuperficie" promptText="Superficie (m²)"/>
      <TextField fx:id="txtHabitaciones" promptText="Habitaciones"/>
      <VBox fx:id="panelDepartamento" spacing="8">
        <Label text="Datos del departamento"/>
        <TextField fx:id="txtPiso" promptText="Piso"/>
        <CheckBox fx:id="chkGastoComun" text="Gasto común al día"/>
        <CheckBox fx:id="chkEstacionamiento" text="Estacionamiento asignado"/>
      </VBox>
      <VBox fx:id="panelCasa" spacing="8">
        <Label text="Datos de la casa"/>
        <CheckBox fx:id="chkPatio" text="Cuenta con patio"/>
      </VBox>
      <Button text="Registrar" onAction="#registrar" maxWidth="Infinity"/>
      <Button text="Eliminar" onAction="#eliminar" maxWidth="Infinity"/>
      <Label fx:id="lblMensaje"/>
    </VBox>
  </right>
</BorderPane>
